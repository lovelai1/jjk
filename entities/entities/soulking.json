      "minecraft:movement": {
        "value": 0.05
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:knockback_resistance": {
        "value": 0.1
      },
      "minecraft:boss": {
        "hud_range": 48,
        "name": "§8-= §r§5Soul, the Void King §8=-"
      },
      "minecraft:on_death": {
        "event": "soulking_die"
      },
			"minecraft:timer": {
				"looping": true,
				"time": 0,
				"time_down_event": {
					"event": "soulking"
				}
			},
      "minecraft:loot": {
        "table": "loot_tables/entities/sus"
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1,
        "track_target": false
