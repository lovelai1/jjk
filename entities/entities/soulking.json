    "events": {
      "soulking_sword": {
        "set_property": {
          "property:soulking_sword": 1
        }
      },
      "soulking_die": {
        "queue_command": {
          "command": [
            "function bosses/file/boss/summons/soulking_death"
          ]
        }
      },
      "soulking": {
        "queue_command": {
          "command": [
            "function bosses/file/boss/summons/soulking"
          ]
        }
      },
      "ds:disappear": {
        "add": {
          "component_groups": [
            "ds:disappear"
          ]
        }
      }
    }
  }
}
