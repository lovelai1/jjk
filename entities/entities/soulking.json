          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:follow_range": 300,
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:behavior.float": {
        "priority": 0
