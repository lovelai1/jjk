{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "scripts": {
        "animate": [
          "health"
        ]
      },
      "animations": {
        "health": "controller.animation.health"
      },
      "properties": {
        "property:soulking_sword": {
          "type": "int",
          "range": [0, 1],
          "default": 1,
          "client_sync": true
        }
      },
      "identifier": "ds:soulking",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
